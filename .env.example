# Es opcional: si falta, la aplicación genera un secreto temporal al arrancar.
# En producción se recomienda definirlo para conservar las sesiones entre reinicios.
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_DURATION=8h
NODE_ENV=development
OFFLINE_ONLY=true

# Reservado para la futura activación de cuentas online.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nexusdata_auth
MYSQL_USER=nexusdata_app
MYSQL_PASSWORD=cambia_esta_contrasena
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root
