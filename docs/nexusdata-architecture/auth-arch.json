  "flows": [
    {
      "id": "register",
      "name": "Registro",
      "nodes": ["electron","authForm","apiClient","express","middleware","rateLimiter","authRoutes","bcrypt","mysql","jwtService","state"],
      "edges": [0,1,2,4,5,7,8,9,10,3],
      "steps": [
        {"nodeId":"electron","text":"App inicia, contextIsolation + sandbox"},
        {"nodeId":"authForm","text":"Renderiza formulario registro"},
        {"nodeId":"authForm","text":"Usuario ingresa username + password"},
        {"nodeId":"apiClient","text":"POST /api/auth/register con credentials:include"},
        {"nodeId":"express","text":"Recibe petición HTTP"},
        {"nodeId":"middleware","text":"cookie-parser + express.json() parsean"},
        {"nodeId":"rateLimiter","text":"Verifica límite: 10 req / 15 min"},
        {"nodeId":"authRoutes","text":"validateCredentials() formato correcto"},
        {"nodeId":"authRoutes","text":"authDb.ensureAvailable() MySQL OK"},
        {"nodeId":"bcrypt","text":"hash(password, 12) — cost 12 (~250ms)"},
        {"nodeId":"mysql","text":"INSERT INTO usuarios (usuario, password_hash)"},
        {"nodeId":"jwtService","text":"issueSession() firma JWT {sub, username}"},
        {"nodeId":"authRoutes","text":"Set cookie httpOnly + 201 Created"},
        {"nodeId":"apiClient","text":"Recibe {user} respuesta"},
        {"nodeId":"state","text":"state.user = result.user, UI actualiza"}
      ]
    },
    {
      "id": "login",
      "name": "Inicio Sesión",
      "nodes": ["electron","authForm","apiClient","express","middleware","rateLimiter","authRoutes","mysql","bcrypt","jwtService","state"],
      "edges": [0,1,2,4,5,7,9,8,10,3],
      "steps": [
        {"nodeId":"electron","text":"App iniciada, muestra login"},
        {"nodeId":"authForm","text":"Renderiza formulario inicio sesión"},
        {"nodeId":"authForm","text":"Usuario ingresa credenciales"},
        {"nodeId":"apiClient","text":"POST /api/auth/login con credentials"},
        {"nodeId":"express","text":"Recibe petición HTTP"},
        {"nodeId":"middleware","text":"Cookie + body parseados"},
        {"nodeId":"rateLimiter","text":"10 req / 15 min verificados"},
        {"nodeId":"authRoutes","text":"validateCredentials() OK"},
        {"nodeId":"mysql","text":"findUserByUsername() SELECT usuario"},
        {"nodeId":"bcrypt","text":"compare(password, hash) validación"},
        {"nodeId":"jwtService","text":"issueSession() firma JWT"},
        {"nodeId":"authRoutes","text":"Set cookie + 200 OK"},
        {"nodeId":"apiClient","text":"Recibe {user} respuesta"},
        {"nodeId":"state","text":"state.user actualizado"}
      ]
    },
    {
      "id": "offline",
      "name": "Modo Offline",
      "nodes": ["electron","authForm","apiClient","express","middleware","authRoutes","offline","jwtService","state"],
      "edges": [0,1,2,4,6,11,10,3],
      "steps": [
        {"nodeId":"electron","text":"App iniciada, muestra login"},
        {"nodeId":"authForm","text":"Renderiza botón 'Entrar offline'"},
        {"nodeId":"authForm","text":"Usuario click offline"},
        {"nodeId":"apiClient","text":"POST /api/auth/offline"},
        {"nodeId":"express","text":"Recibe petición"},
        {"nodeId":"middleware","text":"Cookie + body parseados"},
        {"nodeId":"authRoutes","text":"Rutea a offline handler"},
        {"nodeId":"offline","text":"issueOfflineSession() sin DB"},
        {"nodeId":"jwtService","text":"Firma JWT {sub:'offline', offline:true}"},
        {"nodeId":"authRoutes","text":"Set cookie + 200"},
        {"nodeId":"apiClient","text":"Recibe user offline"},
        {"nodeId":"state","text":"state.user = offline, UI cambia"}
      ]
    },
    {
      "id": "session",
      "name": "Verificar Sesión",
      "nodes": ["electron","apiClient","express","middleware","authRoutes","requireAuth","jwtService","mysql","state"],
      "edges": [17,2,4,6,13,15,16,3],
      "steps": [
        {"nodeId":"electron","text":"App inicia, llama initialiseSession()"},
        {"nodeId":"apiClient","text":"GET /api/auth/me con cookie"},
        {"nodeId":"express","text":"Recibe petición"},
        {"nodeId":"middleware","text":"cookie-parser lee nexusdata_session"},
        {"nodeId":"authRoutes","text":"Rutea a handler /me"},
        {"nodeId":"requireAuth","text":"Middleware: lee cookie, verifica JWT"},
        {"nodeId":"jwtService","text":"jwt.verify() decodifica token"},
        {"nodeId":"mysql","text":"ensureAvailable() + findUser (si online)"},
        {"nodeId":"requireAuth","text":"req.user seteado, pasa"},
        {"nodeId":"authRoutes","text":"Retorna {user} o offline user"},
        {"nodeId":"apiClient","text":"Recibe respuesta"},
        {"nodeId":"state","text":"state.user seteado, app lista"}
      ]
    },
    {
      "id": "protected",
      "name": "API Protegida",
      "nodes": ["apiClient","express","middleware","requireAuth","jwtService","mysql","protectedApis"],
      "edges": [2,4,18,15,16,14],
      "steps": [
        {"nodeId":"apiClient","text":"Solicitud a /api/sources, /api/documents, etc."},
        {"nodeId":"express","text":"Express recibe"},
        {"nodeId":"middleware","text":"Cookie + body parseados"},
        {"nodeId":"requireAuth","text":"Guardián global: lee cookie"},
        {"nodeId":"jwtService","text":"jwt.verify() — si inválido → 401"},
        {"nodeId":"mysql","text":"ensureAvailable() — si caído → 503"},
        {"nodeId":"requireAuth","text":"req.user = {id, username}"},
        {"nodeId":"protectedApis","text":"Handler ejecuta, retorna datos"},
        {"nodeId":"apiClient","text":"Recibe respuesta protegida"}
      ]
    },
    {
      "id": "logout",
      "name": "Cerrar Sesión",
      "nodes": ["apiClient","express","middleware","authRoutes","logout","state"],
      "edges": [2,4,6,12,3],
      "steps": [
        {"nodeId":"apiClient","text":"POST /api/auth/logout"},
        {"nodeId":"express","text":"Express recibe"},
        {"nodeId":"middleware","text":"Parseado"},
        {"nodeId":"authRoutes","text":"Rutea a logout handler"},
        {"nodeId":"logout","text":"res.clearCookie('nexusdata_session')"},
        {"nodeId":"authRoutes","text":"Retorna 204 No Content"},
        {"nodeId":"apiClient","text":"Recibe confirmación"},
        {"nodeId":"state","text":"state.user = null, UI auth mostrada"}
      ]
    }
  ]
